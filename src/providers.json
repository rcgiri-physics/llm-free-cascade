    "baseUrl": "https://api.groq.com/openai/v1",
    "defaultModel": "openai/gpt-oss-120b",
    "fallbackModels": ["qwen/qwen3.8-27b", "openai/gpt-oss-20b"],
    "tier": 1,
    "signupUrl": "https://console.groq.com",
    "freeTierNotes": "per model: 30 RPM, 1K requests/day, 8K tokens/min, 200K tokens/day; limits are per organization, and each model has its own bucket",
    "limits": { "rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000, "perModel": true, "scope": "organization" },
    "limitsSource": "official",
    "verifiedAt": "2026-10-07"
  },
  "gemini": {
    "envVar": "GEMINI_API_KEY",
